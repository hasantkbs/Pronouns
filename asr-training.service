[Unit]
Description=ASR Model Training Service
After=network.target

[Service]
Type=simple
User=server
WorkingDirectory=/home/server/Desktop/project/Pronouns
Environment="PATH=/home/server/Desktop/project/Pronouns/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="CUDA_VISIBLE_DEVICES=0"
ExecStart=/home/server/Desktop/project/Pronouns/venv/bin/python train_adapter.py FurkanV1
StandardOutput=append:/home/server/Desktop/project/Pronouns/logs/training_service.log
StandardError=append:/home/server/Desktop/project/Pronouns/logs/training_service_error.log
Restart=on-failure
RestartSec=10

# Resource limits (48 çekirdek için optimize)
CPUQuota=4000%
MemoryLimit=64G

[Install]
WantedBy=multi-user.target
